# Environment configuration example.
# Copy to .env and replace every placeholder. Never commit .env.

# Runtime mode: development, demo, or production.
# The seed script refuses to run when APP_ENV=production.
APP_ENV=development

# PostgreSQL connection used by Docker Compose.
POSTGRES_DB=itsm
POSTGRES_USER=itsm
POSTGRES_PASSWORD=change-me-local-only

# Host port for PostgreSQL. Change it if 5432 is already in use on your machine.
DB_HOST_PORT=5432

# Application database. Inside Compose the host name is "db".
DATABASE_URL=postgresql+psycopg://itsm:change-me-local-only@db:5432/itsm

# Separate database for pytest. The name must end with _test and must differ
# from DATABASE_URL, otherwise the test suite refuses to start.
TEST_DATABASE_URL=postgresql+psycopg://itsm:change-me-local-only@db:5432/itsm_test

# Only this origin may call the API from a browser.
FRONTEND_ORIGIN=http://localhost:8080

# Uvicorn trusts X-Forwarded-For only from these addresses.
# In production, set this to the Caddy container network only.
FORWARDED_ALLOW_IPS=127.0.0.1

# JWT signing secret (required, at least 32 characters). The API refuses to start
# with this placeholder. Generate a value, for example:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-value

# Used by the seed script: password for the four demo accounts.
DEMO_PASSWORD=replace-with-a-demo-password

# Used from Phase 17: helpdesk chatbot. Leave the key empty to disable the chatbot.
OPENAI_API_KEY=
OPENAI_MODEL=
