# Environment configuration example.
# Copy to .env and replace every placeholder. Never commit .env.

# Runtime mode: development, demo, or production.
# The seed script refuses to run when APP_ENV=production.
APP_ENV=development

# PostgreSQL connection used by Docker Compose.
POSTGRES_DB=itsm
POSTGRES_USER=itsm
POSTGRES_PASSWORD=change-me-local-only

# Host port for PostgreSQL. Change it if 5432 is already in use on your machine.
DB_HOST_PORT=5432

# Application database. Inside Compose the host name is "db".
DATABASE_URL=postgresql+psycopg://itsm:change-me-local-only@db:5432/itsm

# Separate database for pytest. The name must end with _test and must differ
# from DATABASE_URL, otherwise the test suite refuses to start.
TEST_DATABASE_URL=postgresql+psycopg://itsm:change-me-local-only@db:5432/itsm_test

# Only this origin may call the API from a browser.
FRONTEND_ORIGIN=http://localhost:8080

# Uvicorn trusts X-Forwarded-For only from these addresses.
# In production, set this to the Caddy container network only.
FORWARDED_ALLOW_IPS=127.0.0.1

# JWT signing secret (required, at least 32 characters). The API refuses to start
# with this placeholder. Generate a value, for example:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-value

# Used by the seed script: password for the four demo accounts.
DEMO_PASSWORD=replace-with-a-demo-password

# Helpdesk chatbot. Leave the key or the model empty to switch the chatbot off;
# the chat window then points people to the ticket form. Use a model that
# supports tool calling, for example the one your OpenAI account recommends.
OPENAI_API_KEY=
OPENAI_MODEL=
# Seconds to wait for the model before giving up (default 20).
OPENAI_TIMEOUT_SECONDS=20
# Newer OpenAI models answer "Function tools with reasoning_effort are not
# supported" unless this is set to none. Leave it empty for models that do not
# know the setting (they reject it).
OPENAI_REASONING_EFFORT=

# ---- Server only (docker-compose.prod.yml and scripts/) ----
# Public address. Caddy gets an HTTPS certificate for it automatically.
# A real domain, or a free one built from the server IP, e.g. 203-0-113-10.sslip.io
SITE_DOMAIN=
# Contact address for Let's Encrypt certificate notices.
ACME_EMAIL=
# Backups (scripts/backup.sh): S3 bucket created by Terraform. AWS credentials
# go in a separate file readable only by the backup user, not here.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=itsm
